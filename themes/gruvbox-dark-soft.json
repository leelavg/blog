{
  "name": "blog-gruvbox-dark-soft",
  "type": "dark",
  "colors": {
    "editor.background": "#32302f",
    "editor.foreground": "#ebdbb2",
    "editor.selectionBackground": "#504945",
    "editor.lineHighlightBackground": "#504945"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#928374", "fontStyle": "italic" } },
    { "scope": ["attribute", "entity.other.attribute-name"], "settings": { "foreground": "#8ec07c", "fontStyle": "italic" } },
    { "scope": ["constant", "constant.other"], "settings": { "foreground": "#d3869b" } },
    { "scope": ["constant.character", "constant.macro"], "settings": { "foreground": "#8ec07c" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#fe8019" } },
    { "scope": ["constructor", "entity.name.type"], "settings": { "foreground": "#d3869b" } },
    { "scope": "function", "settings": { "foreground": "#b8bb26" } },
    { "scope": ["function.builtin", "support.function.builtin"], "settings": { "foreground": "#fabd2f" } },
    { "scope": ["function.macro", "entity.name.function.macro"], "settings": { "foreground": "#83a598" } },
    { "scope": "keyword", "settings": { "foreground": "#fb4934" } },
    { "scope": ["keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#8ec07c" } },
    { "scope": "label", "settings": { "foreground": "#fb4934" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.heading", "settings": { "foreground": "#8ec07c" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.link.text", "settings": { "foreground": "#fb4934" } },
    { "scope": "markup.link.url", "settings": { "foreground": "#b8bb26", "fontStyle": "underline" } },
    { "scope": ["markup.raw", "markup.inline.raw"], "settings": { "foreground": "#fb4934" } },
    { "scope": "markup.strikethrough", "settings": { "fontStyle": "strikethrough" } },
    { "scope": ["module", "entity.name.namespace"], "settings": { "foreground": "#8ec07c" } },
    { "scope": "operator", "settings": { "foreground": "#d3869b" } },
    { "scope": "punctuation", "settings": { "foreground": "#fe8019" } },
    { "scope": "special", "settings": { "foreground": "#b16286" } },
    { "scope": "string", "settings": { "foreground": "#b8bb26" } },
    { "scope": ["string.regexp", "string.special"], "settings": { "foreground": "#fe8019" } },
    { "scope": "string.symbol", "settings": { "foreground": "#fabd2f" } },
    { "scope": "tag", "settings": { "foreground": "#8ec07c" } },
    { "scope": "type", "settings": { "foreground": "#fabd2f" } },
    { "scope": "type.enum.variant", "settings": { "fontStyle": "italic" } },
    { "scope": "variable.builtin", "settings": { "foreground": "#fe8019", "fontStyle": "italic" } },
    { "scope": "variable.other.member", "settings": { "foreground": "#83a598" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#83a598", "fontStyle": "italic" } },
    { "scope": "invalid", "settings": { "foreground": "#fb4934" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#b8bb26" } },
    { "scope": "markup.changed", "settings": { "foreground": "#fabd2f" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#fb4934" } }
  ]
}
